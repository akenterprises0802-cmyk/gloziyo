# ====================================================================
# Hostinger MySQL Database Configuration for gloziyofire.com / gloziyoemp.com
# ====================================================================
# Retrieve these values directly from your Hostinger hPanel:
# Link: https://hpanel.hostinger.com/websites/gloziyofire.com/databases/my-sql-databases
#
# IMPORTANT for Hostinger:
# In hPanel, go to "Databases" -> "Remote MySQL".
# Under "IP (IPv4 or IPv6)", enter "%" (to allow any IP) or your app IP,
# and select your database name. Click "Create".
# ====================================================================

# MySQL Host provided by Hostinger (e.g., srv123.hstgr.io or your Hostinger server IP or sql.gloziyofire.com)
MYSQL_HOST=srv123.hstgr.io

# MySQL Port (default is 3306)
MYSQL_PORT=3306

# MySQL Database Name from Hostinger (e.g., u123456789_gloziyo)
MYSQL_DATABASE=u123456789_gloziyo

# MySQL Username from Hostinger (e.g., u123456789_admin)
MYSQL_USER=u123456789_admin

# MySQL User Password that you created in Hostinger hPanel
MYSQL_PASSWORD=your_hostinger_mysql_password
